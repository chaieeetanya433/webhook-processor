# PostgreSQL
POSTGRES_USER=webhook
POSTGRES_PASSWORD=webhook
POSTGRES_DB=webhook_processor
DATABASE_URL=postgres://webhook:webhook@localhost:5432/webhook_processor
PG_POOL_MAX=20

# HTTP API
PORT=3001
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Worker coordination & retry settings
WORKER_ID=worker-1
WORKER_CONCURRENCY=4
POLL_INTERVAL_MS=500
LEASE_MS=15000
HEARTBEAT_MS=4000
MAX_ATTEMPTS=5
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=15000
SHUTDOWN_TIMEOUT_MS=10000

# Frontend (browser-reachable API URL)
NEXT_PUBLIC_API_URL=http://localhost:3001
